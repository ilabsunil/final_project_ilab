{
  "_comment": "XPath repository — PNC Bank app. One UNIQUE key per UI element, all kept in ONE place. Each block below is tagged with the module / test case it belongs to via a _comment_* line. Page objects resolve locators by key; never hard-code a selector in a test. {label} placeholders are substituted at runtime by BasePage.byKey().",

  "_comment_login": "TC-001 · Login page",
  "LOGIN_HEADING": "xpath=//h2[normalize-space()='Welcome back']",
  "LOGIN_EMAIL_INPUT": "xpath=//input[@type='email' and @name='email']",
  "LOGIN_PASSWORD_INPUT": "xpath=//input[@type='password' and @name='password']",
  "LOGIN_SUBMIT_BUTTON": "xpath=//button[@type='submit' and contains(normalize-space(),'Sign in')]",
  "LOGIN_ERROR_MESSAGE": "xpath=//div[contains(@class,'error')]",

  "_comment_shell": "SHARED · App shell (welcome heading, breadcrumb, user, sign out) — used by every signed-in test",
  "SHELL_WELCOME_HEADING": "xpath=//h1[contains(normalize-space(),'Good morning,')]",
  "SHELL_BREADCRUMB_CURRENT": "xpath=//header[contains(@class,'topbar')]//strong",
  "SHELL_USER_NAME": "xpath=//div[contains(@class,'user-summary')]//strong",
  "SHELL_SIGN_OUT_BUTTON": "xpath=//button[contains(@class,'logout')]",

  "_comment_nav": "SHARED · Sidebar navigation — used by all module test cases (TC-002..TC-00n)",
  "NAV_DASHBOARD": "xpath=//nav//button[.//span[normalize-space()='Dashboard']]",
  "NAV_USER_DETAILS": "xpath=//nav//button[.//span[normalize-space()='User details']]",
  "NAV_LOANS": "xpath=//nav//button[.//span[normalize-space()='Loans']]",
  "NAV_CREDIT_CARDS": "xpath=//nav//button[.//span[normalize-space()='Credit cards']]",
  "NAV_STATEMENTS": "xpath=//nav//button[.//span[normalize-space()='Statements']]",
  "NAV_ACTIVITY_HISTORY": "xpath=//nav//button[.//span[normalize-space()='Activity history']]",
  "NAV_PREFERENCES": "xpath=//nav//button[.//span[normalize-space()='Preferences']]",

  "_comment_dashboard": "MODULE · Dashboard (service cards)",
  "DASH_SERVICES_HEADING": "xpath=//h2[contains(normalize-space(),'What would you like to explore')]",
  "DASH_SERVICE_CARDS": "xpath=//button[contains(@class,'service-card')]",
  "DASH_SERVICE_CARD_BY_NAME": "xpath=//button[contains(@class,'service-card')][.//strong[normalize-space()='{label}']]",

  "_comment_module_page": "SHARED · Generic list-style module page (Loans, Cards, Statements, Activity, Preferences)",
  "PAGE_TITLE_H1": "xpath=//section[contains(@class,'page-heading')]//h1",
  "PAGE_SUBTITLE": "xpath=//section[contains(@class,'page-heading')]//p[contains(@class,'muted')]",
  "PAGE_PRIMARY_ACTION_BUTTON": "xpath=//section[contains(@class,'page-heading')]//button",
  "LIST_SERVICE_ROWS": "xpath=//section[contains(@class,'banking-list')]//article[contains(@class,'service-row')]",
  "LIST_SERVICE_ROW_TITLES": "xpath=//section[contains(@class,'banking-list')]//article[contains(@class,'service-row')]//h2",
  "LIST_SERVICE_ROW_BY_TITLE": "xpath=//article[contains(@class,'service-row')][.//h2[normalize-space()='{label}']]",

  "_comment_users": "TC-003 · User Details (customer profile card)",
  "USER_PROFILE_CARD": "xpath=//section[contains(@class,'profile-card')]",
  "USER_PROFILE_NAME": "xpath=//section[contains(@class,'profile-card')]//h2",
  "USER_PROFILE_ROLE": "xpath=//section[contains(@class,'profile-card')]//div[contains(@class,'profile-header')]//p",
  "USER_PROFILE_STATUS": "xpath=//section[contains(@class,'profile-card')]//span[contains(@class,'status')]",
  "USER_DETAIL_ITEMS": "xpath=//section[contains(@class,'profile-card')]//div[contains(@class,'detail-item')]",
  "USER_DETAIL_VALUE_BY_LABEL": "xpath=//div[contains(@class,'detail-item')][span[normalize-space()='{label}']]//strong",

  "_comment_loans": "TC-002 · Loans module action",
  "LOANS_APPLY_BUTTON": "xpath=//button[contains(normalize-space(),'Apply for a loan')]",

  "_comment_cards": "TC-004 · Credit Cards module action",
  "CARDS_MANAGE_BUTTON": "xpath=//button[contains(normalize-space(),'Manage cards')]",

  "_comment_statements": "MODULE · Statements action",
  "STATEMENTS_DOWNLOAD_BUTTON": "xpath=//button[contains(normalize-space(),'Download statements')]",

  "_comment_activity": "MODULE · Activity History action",
  "ACTIVITY_DOWNLOAD_BUTTON": "xpath=//button[contains(normalize-space(),'Download activity')]",

  "_comment_preferences": "MODULE · Preferences action",
  "PREFERENCES_EDIT_BUTTON": "xpath=//button[contains(normalize-space(),'Edit preferences')]"
}
