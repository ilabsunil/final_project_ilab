{
  "name": "pnc-playwright-tests",
  "version": "1.0.0",
  "description": "Data-driven Playwright POM framework for the PNC Bank local app with CoverageEngine test-gap reporting",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:final": "start reports/final-execution-report.html",
    "report:share": "node scripts/share-report.js",
    "test:share": "playwright test && node scripts/share-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
